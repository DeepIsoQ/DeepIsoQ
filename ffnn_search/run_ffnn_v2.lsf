#!/bin/bash
#BSUB -J ffnn_gpu_2
#BSUB -q gpua100
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -W 24:00
#BSUB -n 4
#BSUB -R "rusage[mem=32000] span[hosts=1]"
#BSUB -cwd .
#BSUB -o ffnn_search/logs/ffnn_v2_2_%J.out
#BSUB -e ffnn_search/logs/ffnn_v2_2_%J.err
#BSUB -env "all"

# Email notifications (optional)
#BSUB -u s243310@dtu.dk
#BSUB -B
#BSUB -N

echo "[INFO] Job started at $(date)"

# ----------- Ensure output directories exist -----------
mkdir -p ffnn_search/logs
mkdir -p ffnn_search/results/figs_trials

# ----------- Check GPU availability -----------
if ! command -v nvidia-smi &> /dev/null; then
    echo "[ERROR] nvidia-smi not available — GPU not found."
    exit 1
fi

echo "[INFO] GPU detected:"
nvidia-smi

# ----------- Load CUDA + activate environment -----------
module load cuda/12.1

source ~/deep_learning/bin/activate

echo "[INFO] Using Python from: $(which python3)"
python3 --version

# ----------- Run the FFNN script -----------
echo "=== Running FFNN hyperparameter search ==="
python3 -u ffnn_search/ffnn_search_v2.py

echo "[INFO] Job finished at $(date)"
