#!/bin/bash
#BSUB -J ffnn_vae
#BSUB -q gpuv100
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -W 24:00                 
#BSUB -n 4
#BSUB -R "rusage[mem=32000] span[hosts=1]"
#BSUB -cwd .
#BSUB -o ffnn_search/logs/ffnn_vae_%J.out
#BSUB -env "all"

# (optional) email
#BSUB -u s243275@dtu.dk     # <-- your email
#BSUB -B
#BSUB -N

# Safety: check GPU
if ! command -v nvidia-smi &> /dev/null; then
    echo "[ERROR] GPU not found. Exiting."
    exit 1
fi

echo "[INFO] GPU detected:"
nvidia-smi

module load cuda/12.1
source ../venv_dl/bin/activate          # <-- your environment path

echo "=== Starting training ==="
python3 ffnn_vae.py     